{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"type": "object",
	"additionalProperties": false,
	"required": ["status", "goal", "scope", "notDoing", "acceptance", "questions"],
	"properties": {
		"status": { "enum": ["proposed", "blocked"] },
		"goal": { "type": "string", "minLength": 1, "maxLength": 4000 },
		"scope": { "type": "array", "maxItems": 32, "items": { "type": "string", "minLength": 1, "maxLength": 2000 } },
		"notDoing": { "type": "array", "maxItems": 32, "items": { "type": "string", "minLength": 1, "maxLength": 2000 } },
		"acceptance": {
			"type": "array",
			"maxItems": 32,
			"items": { "type": "string", "minLength": 1, "maxLength": 4000 }
		},
		"questions": { "type": "array", "maxItems": 16, "items": { "type": "string", "minLength": 1, "maxLength": 2000 } }
	}
}
