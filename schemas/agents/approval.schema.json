{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"type": "object",
	"additionalProperties": false,
	"required": ["payload", "signature"],
	"properties": {
		"signature": { "type": "string", "minLength": 80, "maxLength": 100 },
		"payload": {
			"type": "object",
			"additionalProperties": false,
			"required": ["version", "keyId", "nonce", "issuedAt", "expiresAt", "binding", "gates", "unknown", "reason"],
			"properties": {
				"version": { "const": 1 },
				"keyId": { "type": "string", "pattern": "^[A-Za-z0-9_.-]{1,80}$" },
				"nonce": { "type": "string", "pattern": "^[A-Za-z0-9_.-]{16,160}$" },
				"issuedAt": { "type": "integer", "minimum": 0 },
				"expiresAt": { "type": "integer", "minimum": 1 },
				"reason": { "type": "string", "minLength": 1, "maxLength": 4000 },
				"binding": {
					"type": "object",
					"additionalProperties": false,
					"required": ["head", "tree", "policy", "contract"],
					"properties": {
						"head": { "type": "string", "pattern": "^[a-f0-9]{40,64}$" },
						"tree": { "type": "string", "pattern": "^[a-f0-9]{40,64}$" },
						"policy": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
						"contract": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
					}
				},
				"gates": {
					"type": "array",
					"uniqueItems": true,
					"items": {
						"type": "string",
						"enum": [
							"security",
							"data",
							"license-brand",
							"billing",
							"release-signing-update",
							"tests-and-guards",
							"major-version"
						]
					}
				},
				"unknown": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } }
			}
		}
	}
}
