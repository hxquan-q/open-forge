{
	"type": "object",
	"additionalProperties": false,
	"required": ["version", "steps"],
	"properties": {
		"version": { "const": 1 },
		"steps": {
			"type": "array",
			"minItems": 1,
			"maxItems": 32,
			"items": {
				"type": "object",
				"additionalProperties": false,
				"required": ["action", "selector"],
				"properties": {
					"action": { "enum": ["visible", "click", "fill", "text"] },
					"selector": { "type": "string", "minLength": 1, "maxLength": 500 },
					"value": { "type": "string", "maxLength": 2000 }
				}
			}
		}
	}
}
