{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"type": "object",
	"additionalProperties": false,
	"required": ["version", "category", "rule", "reason", "evidence"],
	"properties": {
		"version": { "const": 1 },
		"category": { "type": "string", "enum": ["rework", "unwanted-merge", "verification"] },
		"rule": { "type": "string", "minLength": 1, "maxLength": 2000 },
		"reason": { "type": "string", "minLength": 1, "maxLength": 4000 },
		"evidence": {
			"type": "object",
			"additionalProperties": false,
			"required": ["kind", "id"],
			"properties": {
				"kind": { "type": "string", "enum": ["commit", "run"] },
				"id": { "type": "string", "pattern": "^[A-Za-z0-9_.-]{1,160}$" }
			}
		}
	}
}
