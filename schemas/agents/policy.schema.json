{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"title": "Open Forge autonomy policy",
	"type": "object",
	"additionalProperties": false,
	"required": [
		"version",
		"targetLevel",
		"level",
		"paused",
		"capabilities",
		"allowedProviders",
		"differentReviewerFamily",
		"limits",
		"requiredChecks",
		"rollout"
	],
	"properties": {
		"version": { "const": 1 },
		"targetLevel": { "type": "integer", "minimum": 0, "maximum": 4 },
		"level": { "type": "integer", "minimum": 0, "maximum": 4 },
		"paused": { "type": "boolean" },
		"capabilities": {
			"type": "array",
			"uniqueItems": true,
			"items": {
				"type": "string",
				"enum": [
					"plan",
					"triage",
					"lessons",
					"implement",
					"review",
					"verify",
					"verify-ui",
					"verify-packaged",
					"integrate-dev",
					"promote-main",
					"publish-test",
					"publish-stable"
				]
			}
		},
		"allowedProviders": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
		"differentReviewerFamily": { "type": "boolean" },
		"limits": {
			"type": "object",
			"additionalProperties": false,
			"required": [
				"implementers",
				"reviewers",
				"implRounds",
				"reviewRounds",
				"leaseMs",
				"heartbeatMs",
				"wallTimeMs",
				"stallMs",
				"outputBytes"
			],
			"properties": {
				"implementers": { "type": "integer", "minimum": 1, "maximum": 12 },
				"reviewers": { "type": "integer", "minimum": 1, "maximum": 12 },
				"implRounds": { "type": "integer", "minimum": 1, "maximum": 10 },
				"reviewRounds": { "type": "integer", "minimum": 1, "maximum": 10 },
				"leaseMs": { "type": "integer", "minimum": 1000, "maximum": 86400000 },
				"heartbeatMs": { "type": "integer", "minimum": 100, "maximum": 3600000 },
				"wallTimeMs": { "type": "integer", "minimum": 100, "maximum": 86400000 },
				"stallMs": { "type": "integer", "minimum": 100, "maximum": 86400000 },
				"outputBytes": { "type": "integer", "minimum": 1024, "maximum": 16777216 }
			}
		},
		"requiredChecks": {
			"type": "array",
			"minItems": 1,
			"uniqueItems": true,
			"items": { "type": "string", "enum": ["tests", "check", "impact", "ui", "packaged"] }
		},
		"rollout": {
			"type": "object",
			"additionalProperties": false,
			"required": ["steps", "holdMs", "minSessions", "maxCrashRate", "maxCrashRatio", "maxTelemetryAgeMs"],
			"properties": {
				"steps": {
					"type": "array",
					"minItems": 2,
					"uniqueItems": true,
					"items": { "type": "integer", "minimum": 0, "maximum": 100 }
				},
				"holdMs": { "type": "integer", "minimum": 1 },
				"minSessions": { "type": "integer", "minimum": 1 },
				"maxCrashRate": { "type": "number", "minimum": 0, "maximum": 1 },
				"maxCrashRatio": { "type": "number", "minimum": 1 },
				"maxTelemetryAgeMs": { "type": "integer", "minimum": 1 }
			}
		}
	}
}
