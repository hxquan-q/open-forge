{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"type": "object",
	"additionalProperties": false,
	"required": ["version", "adapters"],
	"properties": {
		"version": { "const": 1 },
		"publisher": {
			"type": "object",
			"additionalProperties": false,
			"required": ["enabled", "repository", "command", "queryCommand", "keyId", "artifactRoot"],
			"properties": {
				"enabled": { "type": "boolean" },
				"repository": { "const": "hxquan-q/open-forge" },
				"command": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
				"queryCommand": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
				"keyId": { "type": "string", "pattern": "^[A-Za-z0-9_.-]{1,80}$" },
				"artifactRoot": { "type": "string", "minLength": 1 }
			}
		},
		"adapters": {
			"type": "array",
			"minItems": 1,
			"items": {
				"type": "object",
				"additionalProperties": false,
				"required": [
					"id",
					"enabled",
					"provider",
					"family",
					"model",
					"roles",
					"command",
					"doctorCommand",
					"isolation"
				],
				"properties": {
					"id": { "type": "string", "pattern": "^[a-z][a-z0-9-]{0,63}$" },
					"enabled": { "type": "boolean" },
					"provider": { "type": "string", "minLength": 1 },
					"family": { "type": "string", "minLength": 1 },
					"model": { "type": "string", "minLength": 1 },
					"roles": {
						"type": "array",
						"minItems": 1,
						"uniqueItems": true,
						"items": {
							"type": "string",
							"enum": ["planner", "implementer", "reviewer", "ui-reviewer", "triage", "lessons"]
						}
					},
					"command": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
					"doctorCommand": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
					"isolation": { "type": "string", "enum": ["external-sandbox", "read-only", "none"] }
				}
			}
		}
	}
}
