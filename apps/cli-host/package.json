{
	"name": "@vetta/cli-host",
	"version": "0.1.4",
	"private": true,
	"type": "module",
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"bin": {
		"openforge": "dist/cli.js",
		"openforge-agent": "dist/agent-cli.js",
		"openforge-cli-app": "dist/cli.js",
		"openforge-agent-rpc": "dist/agent-rpc-cli.js"
	},
	"files": ["dist"],
	"scripts": {
		"clean": "rm -rf dist",
		"build": "tsgo -p tsconfig.build.json",
		"typecheck": "tsgo --noEmit -p tsconfig.json",
		"test": "bun ../../scripts/quality/run-vitest.mjs --run --maxWorkers=1",
		"verify:artifact:installed": "bun ../../scripts/quality/run-vitest.mjs --run test/installed-artifact-runtime.test.ts",
		"verify:runtime-contract": "bun run test -- contract.test.ts test/runtime-host.test.ts test/agent-runtime-selection.test.ts test/rpc-session-adapter.test.ts test/session-resource-close.test.ts test/agent-runtime-initialization-failure.test.ts test/agent-print-mode.test.ts"
	},
	"dependencies": {
		"@vetta/ai": "workspace:*",
		"@vetta/action-rpc": "workspace:*",
		"@vetta/coding-agent": "workspace:*",
		"@vetta/ecosystem-adapter": "workspace:*",
		"@vetta/runtime-core": "workspace:*",
		"@vetta/runtime-mcp": "workspace:*",
		"@vetta/runtime-node": "workspace:*",
		"@vetta/runtime-storage": "workspace:*",
		"@vetta/runtime-subagents": "workspace:*",
		"chalk": "^5.5.0",
		"zod": "^4.4.3"
	},
	"optionalDependencies": {
		"@mariozechner/clipboard": "^0.3.2"
	},
	"devDependencies": {
		"typescript": "^5.9.2",
		"@types/node": "^22.10.5"
	}
}
