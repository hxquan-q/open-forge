{
	"id": "eform-craft",
	"name": "%plugin.name%",
	"version": "0.2.0",
	"icon": "icon.png",
	"defaultLocale": "zh",
	"pluginApiVersion": "^2.11.0",
	"entry": "dist/mf-manifest.json",
	"moduleFederation": {
		"remoteName": "eform_craft",
		"expose": "./plugin"
	},
	"permissions": ["agent.skills.control"],
	"agent": {
		"skillPaths": ["agent/skills"],
		"skillPresentation": { "defaultVisibility": "hidden" },
		"agents": [
			{
				"id": "eform",
				"mode": "coding",
				"name": "%agent.eform.name%",
				"description": "%agent.eform.description%",
				"mentionHandle": "eform",
				"systemPromptPath": "agent/agents/eform.md",
				"roles": ["master"]
			},
			{
				"id": "requirements",
				"mode": "coding",
				"name": "%agent.requirements.name%",
				"description": "%agent.requirements.description%",
				"mentionHandle": "eform-requirements",
				"systemPromptPath": "agent/agents/requirements.md",
				"roles": ["business"]
			},
			{
				"id": "developer",
				"mode": "coding",
				"name": "%agent.developer.name%",
				"description": "%agent.developer.description%",
				"mentionHandle": "eform-developer",
				"systemPromptPath": "agent/agents/developer.md",
				"roles": ["developer"]
			},
			{
				"id": "tester",
				"mode": "coding",
				"name": "%agent.tester.name%",
				"description": "%agent.tester.description%",
				"mentionHandle": "eform-tester",
				"systemPromptPath": "agent/agents/tester.md",
				"roles": ["tester"]
			},
			{
				"id": "deployer",
				"mode": "coding",
				"name": "%agent.deployer.name%",
				"description": "%agent.deployer.description%",
				"mentionHandle": "eform-deployer",
				"systemPromptPath": "agent/agents/deployer.md",
				"roles": ["deployer"]
			}
		],
		"teams": [
			{
				"id": "eform-studio",
				"mode": "coding",
				"name": "%team.studio.name%",
				"description": "%team.studio.description%",
				"members": [
					{
						"agent": "eform",
						"responsibility": "Coordinator and single user entry: preflight the session project, establish scope and authorization, coordinate and assist the four members without inventing project facts."
					},
					{
						"agent": "requirements",
						"responsibility": "Requirements and prototypes: parse source attachments when present, confirm requirements and field-value logic, and produce optional presentation prototypes, not production implementation.",
						"instructionsPath": "agent/operating-contract.md"
					},
					{
						"agent": "developer",
						"responsibility": "Implement frontend, backend, APIs, configuration and SQL within the verified AIMES CustomDev contract and confirmed requirements.",
						"instructionsPath": "agent/operating-contract.md"
					},
					{
						"agent": "tester",
						"responsibility": "Choose risk-based black-box and white-box tests; use computer-use where available, otherwise document alternatives; verify local behavior and the complete dev integration package.",
						"instructionsPath": "agent/operating-contract.md"
					},
					{
						"agent": "deployer",
						"responsibility": "Update only the target CustomDev dev test service, restart it and support acceptance with a verified rollback path; no production deployment.",
						"instructionsPath": "agent/operating-contract.md"
					}
				],
				"workflowPath": "agent/workflows/studio.md"
			}
		]
	},
	"description": "%plugin.description%",
	"author": "Vetta"
}
