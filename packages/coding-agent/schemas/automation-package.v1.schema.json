{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"$id": "https://openforge.dev/schemas/automation-package.v1.schema.json",
	"title": "Open Forge Automation Package v1",
	"description": "Versioned envelope for portable scheduled-task definitions. Credentials and session data must not appear.",
	"type": "object",
	"additionalProperties": false,
	"required": ["schemaVersion", "id", "version", "name", "requires", "task"],
	"properties": {
		"schemaVersion": { "const": 1 },
		"id": {
			"type": "string",
			"pattern": "^[a-z][a-z0-9]*(\\.[a-z][a-z0-9-]*)+$",
			"description": "Dotted package identity; becomes the local task id on import."
		},
		"version": {
			"type": "string",
			"pattern": "^\\d+\\.\\d+\\.\\d+(-[0-9A-Za-z.-]+)?$"
		},
		"name": { "type": "string", "minLength": 1, "maxLength": 120 },
		"description": { "type": "string", "maxLength": 2000 },
		"requires": {
			"type": "object",
			"additionalProperties": false,
			"required": ["taskSchemaVersion"],
			"properties": {
				"minAppVersion": {
					"type": "string",
					"pattern": "^\\d+\\.\\d+\\.\\d+(-[0-9A-Za-z.-]+)?$"
				},
				"taskSchemaVersion": { "type": "integer", "minimum": 1 },
				"capabilities": {
					"type": "array",
					"items": { "type": "string", "minLength": 1 },
					"uniqueItems": true
				},
				"platforms": {
					"type": "array",
					"items": { "enum": ["win32", "darwin", "linux"] },
					"uniqueItems": true
				}
			}
		},
		"inputs": {
			"type": "array",
			"items": {
				"type": "object",
				"additionalProperties": false,
				"required": ["key", "type", "label"],
				"properties": {
					"key": { "type": "string", "pattern": "^[a-z][a-zA-Z0-9]*$" },
					"type": { "enum": ["string", "number", "boolean", "path"] },
					"label": { "type": "string", "minLength": 1 },
					"description": { "type": "string" },
					"required": { "type": "boolean" },
					"default": {}
				}
			}
		},
		"task": {
			"type": "object",
			"additionalProperties": false,
			"required": ["name", "prompt", "cron"],
			"properties": {
				"name": { "type": "string", "minLength": 1 },
				"prompt": { "type": "string", "minLength": 1 },
				"cron": { "type": "string", "minLength": 1 },
				"isOnce": { "type": "boolean" },
				"modelKey": { "type": "string", "minLength": 1 },
				"executionMode": { "enum": ["inherit", "sandbox", "full-access"] },
				"skill": {
					"type": "object",
					"additionalProperties": false,
					"required": ["name", "type"],
					"properties": {
						"name": { "type": "string", "minLength": 1 },
						"alias": { "type": "string", "minLength": 1 },
						"type": { "enum": ["skill", "scene"] }
					}
				},
				"permissionTiers": {
					"type": "object",
					"additionalProperties": false,
					"properties": {
						"allowWorkspaceWrite": { "type": "boolean" },
						"allowCommonCommands": { "type": "boolean" },
						"allowBatchDelete": { "type": "boolean" },
						"allowSystemTools": { "type": "boolean" },
						"autoApprovePrompts": { "type": "boolean" }
					}
				}
			}
		}
	}
}
