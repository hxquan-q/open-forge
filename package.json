{
	"name": "open-forge",
	"private": true,
	"type": "module",
	"packageManager": "bun@1.3.14",
	"workspaces": [
		"packages/capability-sdk",
		"packages/capability-runtime",
		"packages/ai",
		"packages/agent",
		"packages/ecosystem-adapter",
		"packages/coding-agent",
		"packages/plugins/plugin-sdk",
		"packages/plugins/plugin-vite",
		"packages/plugins/plugin-cli",
		"packages/plugins/presets/*",
		"packages/plugins/externals/*",
		"packages/theme-sdk",
		"packages/theme-ui",
		"packages/themes/builtin/*",
		"packages/ui",
		"packages/markdown",
		"packages/runtime-core",
		"packages/action-rpc",
		"packages/remote-control",
		"packages/remote-desktop",
		"packages/runtime-subagents",
		"packages/agent-team",
		"packages/runtime-knowledge",
		"packages/runtime-tools",
		"packages/runtime-mcp",
		"packages/runtime-storage",
		"packages/runtime-memory",
		"packages/runtime-node",
		"packages/runtime-telemetry",
		"packages/runtime-desktop",
		"packages/toolkit",
		"packages/ssh-transport",
		"packages/runtime-ssh",
		"packages/skill-presets",
		"apps/cli-host",
		"apps/desktop",
		"apps/mobile",
		"apps/remote-relay",
		"apps/docs-site",
		"packages/coding-agent/examples/extensions/with-deps",
		"packages/coding-agent/examples/extensions/custom-provider-anthropic",
		"packages/coding-agent/examples/extensions/custom-provider-gitlab-duo",
		"packages/coding-agent/examples/extensions/custom-provider-qwen-cli"
	],
	"scripts": {
		"clean": "bun run --workspaces clean",
		"build": "turbo run build --filter='./packages/*' --filter=@vetta-org/plugin-cli --filter=@vetta-org/plugin-vite --summarize && bun run build:preset:prebuilt",
		"build:all": "turbo run build --filter=@vetta/desktop --filter=@vetta-org/plugin-cli --summarize",
		"build:desktop": "turbo run build --filter=@vetta/desktop --filter=@vetta-org/plugin-cli --summarize",
		"build:cli": "turbo run build --filter=@vetta/cli-host --filter=@vetta-org/plugin-cli --filter=@vetta-org/plugin-vite --summarize && bun run build:preset:prebuilt",
		"build:docs": "turbo run build --filter=@vetta/docs-site --summarize",
		"dev:mobile": "bun run --cwd apps/mobile start",
		"build:preset": "bun run --cwd apps/desktop build:presets",
		"build:preset:prebuilt": "bun run --cwd apps/desktop build:presets:prebuilt",
		"dev": "turbo run dev --filter=@vetta/ai --filter=@vetta/agent-core --filter=@vetta/coding-agent",
		"dev:tsc": "concurrently --names \"ai\" --prefix-colors \"cyan\" \"cd packages/ai && bun run dev:tsc\"",
		"verify:ui:start": "bun run --cwd apps/desktop verify:ui:start",
		"verify:ui:start:fresh": "bun run --cwd apps/desktop verify:ui:start:fresh",
		"verify:ui:start:debug": "bun run --cwd apps/desktop verify:ui:start:debug",
		"verify:ui:sync:debug": "bun run --cwd apps/desktop verify:ui:sync:debug",
		"verify:ui:status": "bun run --cwd apps/desktop verify:ui:status",
		"verify:ui:status:debug": "bun run --cwd apps/desktop verify:ui:status:debug",
		"verify:ui:status:dev": "bun run --cwd apps/desktop verify:ui:status:dev",
		"verify:ui:stop": "bun run --cwd apps/desktop verify:ui:stop",
		"verify:ui:stop:debug": "bun run --cwd apps/desktop verify:ui:stop:debug",
		"verify:ui:attach": "bun run --cwd apps/desktop verify:ui:attach",
		"verify:ui:attach:debug": "bun run --cwd apps/desktop verify:ui:attach:debug",
		"verify:ui:attach:dev": "bun run --cwd apps/desktop verify:ui:attach:dev",
		"verify:ui:pw": "bun run --cwd apps/desktop verify:ui:pw",
		"verify:ui:pw:debug": "bun run --cwd apps/desktop verify:ui:pw:debug",
		"verify:ui:pw:dev": "bun run --cwd apps/desktop verify:ui:pw:dev",
		"verify:ui:detach": "bun run --cwd apps/desktop verify:ui:detach",
		"verify:ui:debug": "bun run --cwd apps/desktop verify:ui:debug",
		"verify:ui:debug:debug": "bun run --cwd apps/desktop verify:ui:debug:debug",
		"verify:ui:debug:dev": "bun run --cwd apps/desktop verify:ui:debug:dev",
		"verify:ui:runtime-canary": "bun run --cwd apps/desktop verify:ui:runtime-canary",
		"verify:artifact:installed": "bun run --cwd apps/cli-host verify:artifact:installed",
		"verify:runtime-contract": "bun run --cwd apps/cli-host verify:runtime-contract",
		"verify:desktop:contracts": "bun run --cwd apps/desktop verify:packaging:contract",
		"verify:desktop:scope": "node scripts/quality/desktop-packaging-scope.mjs",
		"test:desktop:packaging": "bun run --cwd apps/desktop test:packaging",
		"verify:agent-hosts": "bun scripts/verify-coding-agent-hosts.mjs",
		"check:lint": "bun run scripts/quality/check-lint.mjs",
		"check:lint:fix": "bun run scripts/quality/check-lint.mjs --write",
		"check:types": "concurrently --names \"root,cli,desktop,docs,mobile\" --prefix-colors \"blue,yellow,green,magenta,cyan\" \"tsgo --noEmit\" \"bun run --cwd apps/cli-host typecheck\" \"bun run --cwd apps/desktop typecheck:incremental\" \"bun run --cwd apps/docs-site check\" \"bun run --cwd apps/mobile typecheck\"",
		"check:types:build-surfaces": "bunx tsgo --noEmit -p apps/cli-host/tsconfig.build.json",
		"check:guards": "bun run scripts/quality/check-guards.mjs",
		"check:staged": "bunx @biomejs/biome check --write --error-on-warnings --staged --no-errors-on-unmatched",
		"check:precommit": "bun run scripts/quality/precommit.mjs",
		"check:quick": "bun run scripts/quality/check-quick.mjs",
		"check": "concurrently --names \"lint,types,guards,mobile-lint\" --prefix-colors \"cyan,yellow,magenta,green\" \"bun run check:lint\" \"bun run check:types\" \"bun run check:guards\" \"bun run --cwd apps/mobile lint\"",
		"fix": "bun run check:lint:fix",
		"test": "bun run scripts/quality/test-pkg.mjs --all",
		"vitest": "bun scripts/quality/run-vitest.mjs",
		"test:quality": "bun scripts/quality/run-vitest.mjs --run .claude/hooks/check-file-lines.test.mjs scripts/quality/quality-gates.test.mjs scripts/quality/workflow-skills.test.mjs scripts/quality/check-agent-guide.test.mjs scripts/quality/check-glossary.test.mjs scripts/quality/coding-agent-architecture.test.mjs scripts/quality/coding-agent-tool-public-surface.test.mjs scripts/quality/runtime-coding-agent-independence.test.mjs scripts/quality/runtime-subagents-boundary.test.mjs scripts/quality/conversation-message-architecture.test.mjs scripts/quality/runtime-failure-contract.test.mjs scripts/quality/runtime-platform-boundary.test.mjs scripts/quality/runtime-storage-protocol-boundary.test.mjs scripts/quality/runtime-tools-protocol-boundary.test.mjs scripts/quality/runtime-mcp-protocol-boundary.test.mjs scripts/quality/runtime-product-semantic-boundary.test.mjs scripts/quality/agent-ai-maintainability.test.mjs scripts/release/resolve-desktop-release-config.test.mjs scripts/release/release-notes.test.mjs scripts/release-desktop.test.mjs scripts/release/package-release-policy.test.mjs scripts/worktree/contract.test.mjs scripts/quality/check-task-worktrees.test.mjs scripts/quality/project-indexes.test.mjs scripts/quality/context-boundaries.test.mjs scripts/quality/check-waivers.test.mjs scripts/quality/check-protocol-suites.test.mjs scripts/quality/session-event-tombstones.test.mjs scripts/quality/check-pr-title.test.mjs scripts/quality/check-version-lines.test.mjs scripts/worktree/config.test.mjs scripts/worktree/git.test.mjs scripts/quality/desktop-packaging-scope.test.mjs scripts/quality/desktop-release-workflow.test.mjs apps/desktop/scripts/fetch-vendor-runtimes.test.mjs scripts/quality/ci-dependency-install.test.mjs apps/desktop/scripts/verify-packaging-contract.test.mjs scripts/quality/ssh-helper-cross-targets.test.mjs scripts/agents scripts/quality/autonomy-entrypoints.test.mjs",
		"test:unit": "bun run scripts/quality/test-pkg.mjs --all",
		"test:pkg": "bun run scripts/quality/test-pkg.mjs",
		"test:impact": "bun run scripts/quality/test-impact.mjs",
		"test:changed": "bun run scripts/quality/test-changed.mjs",
		"task:worktree": "bun run scripts/worktree/cli.mjs",
		"worktree:create": "bun run scripts/worktree/cli.mjs create",
		"worktree:status": "bun run scripts/worktree/cli.mjs status",
		"worktree:check": "bun run scripts/worktree/cli.mjs check",
		"worktree:remove": "bun run scripts/worktree/cli.mjs remove",
		"worktree:doctor": "bun run scripts/worktree/cli.mjs doctor",
		"eval:agent": "bun scripts/eval/run.mjs",
		"deadcode": "knip --config knip.config.ts",
		"deadcode:report": "knip --config knip.config.ts --no-exit-code",
		"prepublishOnly": "bun run clean && bun run build && bun run check",
		"publish": "bun run prepublishOnly && node scripts/release/publish-private.mjs",
		"publish:dry": "bun run prepublishOnly && npm publish -ws --dry-run",
		"publish:private": "bun run prepublishOnly && node scripts/release/publish-private.mjs",
		"release:patch": "node scripts/release.mjs patch",
		"release:minor": "node scripts/release.mjs minor",
		"release:major": "node scripts/release.mjs major",
		"release:desktop:patch": "node scripts/release-desktop.mjs prepare patch",
		"release:desktop:minor": "node scripts/release-desktop.mjs prepare minor",
		"release:desktop:initial": "node scripts/release-desktop.mjs prepare --version",
		"release:desktop:publish": "node scripts/release-desktop.mjs publish",
		"prepare": "husky",
		"agent:doctor": "node scripts/agents/cli.mjs doctor",
		"agent:queue": "node scripts/agents/cli.mjs queue",
		"agent:prepare": "node scripts/agents/cli.mjs prepare",
		"agent:cycle": "node scripts/agents/cli.mjs cycle",
		"agent:approval": "node scripts/agents/cli.mjs approval",
		"agent:integration-preview": "node scripts/agents/cli.mjs integration-preview",
		"agent:integrate": "node scripts/agents/cli.mjs integrate",
		"agent:plan": "node scripts/agents/cli.mjs plan",
		"agent:claim": "node scripts/agents/cli.mjs claim",
		"agent:run": "node scripts/agents/cli.mjs run",
		"agent:verify": "node scripts/agents/cli.mjs verify",
		"agent:evidence": "node scripts/agents/cli.mjs evidence",
		"agent:status": "node scripts/agents/cli.mjs status",
		"agent:release": "node scripts/agents/cli.mjs release",
		"agent:recover": "node scripts/agents/cli.mjs recover",
		"agent:pause": "node scripts/agents/cli.mjs pause",
		"agent:resume": "node scripts/agents/cli.mjs resume",
		"agent:signal": "node scripts/agents/cli.mjs signal",
		"agent:nightly": "node scripts/agents/cli.mjs nightly",
		"agent:lesson": "node scripts/agents/cli.mjs lesson",
		"agent:lessons-report": "node scripts/agents/cli.mjs lessons-report",
		"agent:digest": "node scripts/agents/cli.mjs digest",
		"agent:publish": "node scripts/agents/cli.mjs publish",
		"agent:reconcile": "node scripts/agents/cli.mjs reconcile",
		"agent:rollout": "node scripts/agents/cli.mjs rollout",
		"agent:resume-rollout": "node scripts/agents/cli.mjs resume-rollout",
		"agent:cleanup-subject": "node scripts/agents/cli.mjs cleanup-subject",
		"agent:cleanup-proof": "node scripts/agents/cli.mjs cleanup-proof",
		"test:agents": "bun scripts/quality/run-vitest.mjs --run scripts/agents"
	},
	"devDependencies": {
		"@biomejs/biome": "2.3.5",
		"@playwright/cli": "^0.1.17",
		"@sinclair/typebox": "^0.34.41",
		"@types/node": "^22.10.5",
		"@typescript/native-preview": "7.0.0-dev.20260120.1",
		"@vitest/coverage-v8": "4.1.11",
		"concurrently": "^9.2.1",
		"deepeval": "^0.9.17",
		"husky": "^9.1.7",
		"knip": "5.88.1",
		"promptfoo": "^0.123.1",
		"tsx": "^4.20.3",
		"turbo": "2.10.11",
		"typescript": "^5.9.2",
		"vitest": "^4.1.11"
	},
	"engines": {
		"node": ">=20.0.0"
	},
	"version": "0.1.3",
	"dependencies": {
		"@mariozechner/jiti": "^2.6.5",
		"@radix-ui/react-popover": "^1.1.15",
		"@radix-ui/react-select": "^2.2.6",
		"@radix-ui/react-slot": "^1.2.4",
		"@vetta/cli-host": "workspace:*",
		"@vetta/coding-agent": "workspace:*",
		"date-fns": "^4.1.0",
		"get-east-asian-width": "^1.4.0",
		"koffi": "^2.15.1"
	},
	"overrides": {
		"@types/react": "19.2.17",
		"rimraf": "6.1.2",
		"@wdio/native-utils": "2.6.0",
		"react": "19.2.8",
		"react-dom": "19.2.8",
		"adm-zip": "^0.6.1",
		"svgo": "^4.1.0"
	},
	"patchedDependencies": {
		"fumadocs-core@16.14.1": "patches/fumadocs-core@16.14.1.patch"
	}
}
